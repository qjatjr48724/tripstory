# Supabase 프로젝트 설정 (https://supabase.com)
# 이 파일을 복사해 `.env`로 저장한 뒤 값을 채우세요.
# `.env`는 git에 커밋하지 않습니다.
#
# SUPABASE_URL 은 Project URL 전체입니다.
# 예: https://xxxxxxxx.supabase.co
# (/rest/v1/ 은 붙이지 마세요 — 클라이언트가 알아서 붙입니다.)

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Places API (New) — 해외 장소 검색
# Google Cloud Console에서 Places API (New) 활성화 후 API 키 발급
# https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_PLACES_API_KEY=

# 네이버 지역 검색 — NAVER API HUB (네이버 클라우드)
# 개발자센터에서는 2026-07-31 이후 검색 API 신규 신청 불가
# https://console.ncloud.com/ → NAVER API HUB → Application 등록 → 「지역」선택
# Client ID → NAVER_CLIENT_ID, Client Secret → NAVER_CLIENT_SECRET
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
